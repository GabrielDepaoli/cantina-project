# Modelo de configuração. Copie para .env (não é versionado) e preencha.
# Se algo estiver errado, o app mostra uma tela de erro dizendo o que corrigir.

# Só a URL base do projeto, sem caminho (sem /rest/v1/).
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
# A ref do projeto (o subdomínio da URL). Opcional: se preenchida e não bater
# com a URL, o app mostra uma tela de erro em vez de abrir.
VITE_SUPABASE_PROJECT_ID=""

# NUNCA coloque senha aqui com prefixo VITE_: no `npm run dev`, toda variável
# VITE_* vai no JavaScript servido ao navegador. O login é feito na tela de
# login, com o usuário do Supabase Auth.
