# Modelo de configuração. Copie para:
#   .env                -> PRODUÇÃO, usado por `npm run dev` e pelo build
#   .env.staging.local  -> STAGING, usado por `npm run dev:staging`
#                          (o que faltar nele é herdado do .env de produção;
#                          por isso preencha TODAS as variáveis abaixo nele)
# Nenhum dos dois é versionado. Passo a passo de staging: supabase/staging/LEIAME.md

# Só a URL base do projeto, sem caminho (sem /rest/v1/).
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
# A ref do projeto (o subdomínio da URL). Obrigatória em staging: se não bater
# com a URL, o app mostra uma tela de erro em vez de abrir.
VITE_SUPABASE_PROJECT_ID=""

# Only used for the temporary dev-mode auto-login (see ProtectedRoute.tsx /
# AuthContext.tsx). Leave blank to disable auto-login and require the real
# login screen.
VITE_DEV_ADMIN_EMAIL=""
VITE_DEV_ADMIN_PASSWORD=""
